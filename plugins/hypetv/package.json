{
  "name": "hypemeet-plugin-hypetv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"bun --watch server/index.ts\" \"vite\"",
    "mock": "bun dev/mock-xtream.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build && vite build --mode tv",
    "start": "NODE_ENV=production bun server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.52.0",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "lightningcss": "1.33.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
